{
	"name": "canvas",
	"version": "0.0.1",
	"private": true,
	"description": "A collaborative canvas using SharedTree and Fluid Presence.",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "npm run compile && vite build",
		"build:prod": "npm run build",
		"ci:test": "npm run test",
		"compile": "tsc -b",
		"dev": "cross-env vite serve",
		"dev:network": "cross-env vite serve --host",
		"dev:local": "cross-env FLUID_CLIENT='local' vite serve",
		"dev:azure": "cross-env FLUID_CLIENT='azure' vite serve",
		"dev:ios": "npm run dev:network",
		"network-ip": "node scripts/get-network-ip.js",
		"format": "prettier src --write",
		"lint": "eslint src",
		"start": "npm run dev",
		"start:server": "azure-local-service",
		"pretest": "playwright install --with-deps chromium",
		"test": "playwright test",
		"webpack": "vite build"
	},
	"engines": {
		"node": ">=22.22.2"
	},
	"dependencies": {
		"@azure/msal-browser": "^5.9.0",
		"@fluentui/react-avatar": "^9.7.5",
		"@fluentui/react-button": "^9.4.4",
		"@fluentui/react-components": "^9.74.9",
		"@fluentui/react-dialog": "^9.13.6",
		"@fluentui/react-icons": "^2.0.334",
		"@fluentui/react-menu": "^9.16.7",
		"@fluentui/react-message-bar": "^9.3.5",
		"@fluentui/react-provider": "^9.16.7",
		"@fluentui/react-swatch-picker": "^9.1.82",
		"@fluentui/react-text": "^9.5.2",
		"@fluentui/react-textarea": "^9.4.88",
		"@fluentui/react-theme": "^9.1.24",
		"@fluentui/react-toolbar": "^9.2.27",
		"@fluentui/react-tooltip": "^9.4.38",
		"@fluidframework/azure-client": "^3.5.0",
		"@fluidframework/presence": "^3.5.0",
		"@fluidframework/test-runtime-utils": "^3.5.0",
		"@fluidframework/tree": "^3.5.0",
		"@microsoft/microsoft-graph-client": "^3.0.7",
		"@tailwindcss/vite": "^4.0.9",
		"@tanstack/react-table": "^8.20.6",
		"@tanstack/react-virtual": "^3.13.0",
		"@vitejs/plugin-react": "^4.3.4",
		"axios": "^1.19.0",
		"dotenv": "^16.4.7",
		"fluid-framework": "^3.5.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"unique-names-generator": "^4.7.1",
		"uuid": "^14.0.0",
		"vite": "^7.0.1"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.2.0",
		"@eslint/js": "^9.18.0",
		"@fluidframework/azure-local-service": "^3.5.0",
		"@fluidframework/build-common": "^2.0.3",
		"@fluidframework/devtools": "^3.5.0",
		"@microsoft/microsoft-graph-types": "^2.43.1",
		"@playwright/test": "^1.57.0",
		"@types/node": "^22.20.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@typescript-eslint/eslint-plugin": "~8.71.1",
		"@typescript-eslint/parser": "~8.71.1",
		"cross-env": "^10.1.0",
		"eruda": "^3.4.3",
		"eslint": "~9.39.5",
		"eslint-plugin-react": "^7.37.4",
		"globals": "^15.13.0",
		"playwright": "^1.63.0",
		"prettier": "^3.9.6",
		"rollup-plugin-visualizer": "^6.0.3",
		"tailwindcss": "^4.2.0",
		"typescript": "~6.0.3"
	}
}
