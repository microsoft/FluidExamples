{
	"compilerOptions": {
		// DO NOT EDIT
		"outDir": "./dist",
		"rootDir": "./src",
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "Node16",
		"sourceMap": true,
		// Set your preferences here for TypeScript
		"strict": true,
		"jsx": "react-jsx",
		"moduleResolution": "Node16",
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"types": ["node"],
		"noUncheckedSideEffectImports": false,
	},
	"include": ["src"],
}
